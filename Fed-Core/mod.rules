ID = "st-afa.beta_coremod"
Name = "[Beta] ST-AFA - Core"
Version = "[Beta] 0.4.0.3"
CompatibleGameVersions = ["0.30.4c"]
ModifiesMultiplayer = true
Author = "ST-AFA Mod-Team"
Logo = logo.png
Description = "For full details please see Steam Workshop\n\n"\
			  "Adds new STAR TREK stuff to the game \n"\
			  "- replaces FTL jump sound with warp sounds\n"\
			  "- adds Starfleet related editor groups\n"\
			  "- adds new resource: torpedo parts and factories\n"\
			  "- adds new resource: antimatter and factories\n"\
			  "- adds new resource: dilithium crystals\n"\
			  "- adds new resource: duranium and factories\n"
StringsFolder = "strings"

Actions:
&<adaptations.rules>/Adaptations
[
	//******************** Render Layers ********************
	{
		Action = AddMany
		AddTo = "<ships/terran/terran.rules>/Terran/RenderLayers"
		CreateIfNotExisting = true
		IgnoreIfNotExisting = true
		ManyToAdd = &<render_layers.rules>/RenderLayers		
	}
	//******************** EDITOR GROUPS ********************
	{
		Action = Add
		AddTo = "<gui/game/designer/editor_groups.rules>"
		Name = "Starfleet"
		CreateIfNotExisting = true
		IgnoreIfNotExisting = true
		ToAdd
		{
			NameKey = "EditorGroups/Starfleet"	// to be changed to Starfleet
			Icon
			{
				Texture
				{
					File = "images/starfleet.png"
					MipLevels = 2
					SampleMode = Linear
				}
			}
		}
	}
	{
		Action = Add
		AddTo = "<gui/game/designer/editor_groups.rules>"
		Name = "StarfleetWeapons"
		CreateIfNotExisting = true
		IgnoreIfNotExisting = true
		ToAdd
		{
			NameKey = "EditorGroups/Starfleet_Weapons"	// to be changed to Starfleet
			Icon
			{
				Texture
				{
					File = "images/starfleet_weapons.png"
					MipLevels = 2
					SampleMode = Linear
				}
			}
		}
	}
	{
		Action = Add
		AddTo = "<gui/game/designer/editor_groups.rules>"
		Name = "StarfleetFlight"
		CreateIfNotExisting = true
		IgnoreIfNotExisting = true
		ToAdd
		{
			NameKey = "EditorGroups/Starfleet_Flight"	// to be changed to Starfleet
			Icon
			{
				Texture
				{
					File = "images/starfleet_flight.png"
					MipLevels = 2
					SampleMode = Linear
				}
			}
		}
	}
	{
		Action = Add
		AddTo = "<gui/game/designer/editor_groups.rules>"
		Name = "StarfleetPower"
		CreateIfNotExisting = true
		IgnoreIfNotExisting = true
		ToAdd
		{
			NameKey = "EditorGroups/Starfleet_Power"	// to be changed to Starfleet
			Icon
			{
				Texture
				{
					File = "images/starfleet_power.png"
