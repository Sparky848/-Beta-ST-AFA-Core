//		]
//	}
	{
		Action = AddMany
		AddTo = "<modes/career/career.rules>/BaseTradeShip/ResourcesCarried"
		ManyToAdd
		[
			{ ResourceType=antimatter;              RandomWeight=19;  RandomQuantity=[50%, 100%]; }
			{ ResourceType=dilithium;           	RandomWeight=6;  RandomQuantity=[20%, 100%]; }
			{ ResourceType=duranium_stafa;           	RandomWeight=10;  RandomQuantity=[75%, 100%]; }
			{ ResourceType=duranium_alloy;           	RandomWeight=8;  RandomQuantity=[50%, 100%]; }
			{ ResourceType=torpedo_part;   			RandomWeight=20;  RandomQuantity=[75%, 100%]; }
			{ ResourceType=quantum_torpedo_part;   			RandomWeight=15;  RandomQuantity=[50%, 100%]; }
			{ ResourceType=tricobalt_torpedo_part;   			RandomWeight=10;  RandomQuantity=[25%, 100%]; }
			{ ResourceType=transphasic_torpedo_part;   			RandomWeight=3;  RandomQuantity=[10%, 100%]; }
			{ ResourceType=latinum_crystal;   			RandomWeight=3;  RandomQuantity=[10%, 100%]; }
//			{ ResourceType=latinum_slip;   			RandomWeight=10;  RandomQuantity=[10%, 100%]; }
//			{ ResourceType=latinum_strip;   			RandomWeight=8;  RandomQuantity=[10%, 100%]; }
//			{ ResourceType=latinum_bar;   			RandomWeight=2;  RandomQuantity=[10%, 100%]; }
			{ ResourceType=latinum_brick;   			RandomWeight=.1;  RandomQuantity=[50%, 100%]; }
		]
	}
