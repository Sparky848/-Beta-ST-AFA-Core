		Name = "Dilithium"
		CreateIfNotExisting = true
		IgnoreIfNotExisting = true
		ToAdd
		{
			NameKey = "Resource/Dilithium"
			Icon
			{
				Texture = &<resources/dilithium/dilithium.rules>/Overlay/Texture
				VertexColor = [0, 183, 255]
			}
			SortOrder = 300
		}
	}
	{
