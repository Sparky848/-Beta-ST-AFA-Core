	{
		Action = Add
		AddTo = "<./Data/gui/game/parts/part_stats.rules>/PartStats"
		ToAdd 
		{
			ID = WeaponBuff
			FormatKey = "Stats/WeaponBuffFmt"
		}
		OnlyIfNotExisting = false
	}

	//New colour rarity for latinum
	{
		Action = Overrides
		OverrideIn = "<./Data/resources/resources.rules>/Nuggets/Rarities"
		Overrides
		{
			UltraRare
			{
				UseFogDot = true;
				BucketOrder = 5
				FogDotSprite
				{
					Shader = "./Data/pivot.shader"
					Texture = "./Data/gui/dot.png"
					VertexColor = [255, 218, 95, 232] // yellow
					Size = [0.25, 0.25]
				}
				FogDotSizeExponent = 0.85
			}
		}
	}

	{
		Action = Overrides
		OverrideIn = "<./Data/modes/career/sectors/sysgen_standard_nebulas.rules>"
		Overrides
		{
			CloudyNebulaAsteroidTypes
			[
				&<./Data/modes/career/sectors/sysgen_asteroids.rules>/CommonAsteroidTypes/0 //asteroid_s
