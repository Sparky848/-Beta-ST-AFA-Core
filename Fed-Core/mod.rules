	//Adding asteroid spawners to nebula, for latinum
	//Cloudy
	{
		Action = Overrides
		OverrideIn = "<./Data/modes/career/sectors/sysgen_standard_nebulas.rules>/SubSpawners/0"
		Overrides
		{
			SubSpawners
			[
				{
					Type = Doodads
					Count = [0, 10]
					Distance = [1000, 2500]
					Tags = [rare_asteroid, asteroid]
					MinDistanceFromTags
					[
						[rare_asteroid, 500]
						[asteroid, 100]
					]
					SuppressLocationAssertions = true
					DoodadTypes = &<./Data/modes/career/sectors/sysgen_standard_nebulas.rules>/CloudyNebulaAsteroidTypes
				}
			]
		}
	}
